			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Filter_CSV",
						"type": "Filter",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@variables('FileList')",
								"type": "Expression"
							},
							"condition": {
								"value": "@and(equals(item().type,'File'),endsWith(toLower(item().name),'.csv'))",

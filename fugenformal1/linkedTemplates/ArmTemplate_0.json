							},
							{
								"name": "orders.csv",
								"type": "File"
							},
							{
								"name": "employees.json",
								"type": "File"
							},
							{
								"name": "products.parquet",
								"type": "File"
							}
						]
					}
				},
				"annotations": []
			},
			"dependsOn": []

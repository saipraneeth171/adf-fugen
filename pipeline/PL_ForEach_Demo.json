								"variableName": "CurrentEmployee",
								"value": {
									"value": "@item()",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"variables": {
			"EmployeeList": {
				"type": "Array",
				"defaultValue": [
					"Ravi",
					"Priya",
					"Kumar",
					"Anil",
					"Sneha"
				]
			},
			"CurrentEmployee": {
				"type": "String"
			}
		},
		"annotations": []
	}
}
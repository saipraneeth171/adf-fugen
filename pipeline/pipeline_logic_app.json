{
	"name": "pipeline_logic_app",
	"properties": {
		"activities": [
			{
				"name": "Set_Employee_Name",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vEmployeeName",
					"value": "\"?!"
				}
			},
			{
				"name": "Send_Success_Notification",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Set_Employee_Name",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().parameters.LogicAppUrl",
						"type": "Expression"
					},
					"body": {
						"value": "@concat(\n    '{\"pipelineName\":\"',pipeline().Pipeline,\n    '\",\"dataFactoryName\":\"',pipeline().DataFactory,\n    '\",\"runId\":\"',pipeline().RunId,\n    '\",\"employeeName\":\"',variables('vEmployeeName'),\n    '\",\"status\":\"Succeeded',\n    '\",\"message\":\"Pipeline executed successfully\"}'\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Send_Failure_Notification",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Fail1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().parameters.LogicAppUrl",
						"type": "Expression"
					},
					"body": {
						"value": "@concat(\n    '{\"pipelineName\":\"',pipeline().Pipeline,\n    '\",\"dataFactoryName\":\"',pipeline().DataFactory,\n    '\",\"runId\":\"',pipeline().RunId,\n    '\",\"employeeName\":\"',variables('vEmployeeName'),\n    '\",\"status\":\"Failed',\n    '\",\"message\":\"Pipeline execution failed\"}'\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Fail1",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Set_Employee_Name",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": "Intentional failure for testing",
					"errorCode": "DEMO_FAILURE"
				}
			}
		],
		"parameters": {
			"LogicAppUrl": {
				"type": "String"
			}
		},
		"variables": {
			"vEmployeeName": {
				"type": "String",
				"defaultValue": "1\""
			}
		},
		"annotations": []
	}
}
{
	"name": "pipeline_logic_app",
	"properties": {
		"activities": [
			{
				"name": "Set_Employee_Name",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vEmployeeName",
					"value": "12"
				}
			},
			{
				"name": "Send_Success_Notification",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Set_Employee_Name",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().parameters.LogicAppUrl",
						"type": "Expression"
					},
					"body": {
						"value": "@concat('{\"pipelineName\":\"',pipeline().Pipeline,'\",\"dataFactoryName\":\"',pipeline().DataFactory,'\",\"runId\":\"',pipeline().RunId,'\",\"employeeName\":\"',variables('vEmployeeName'),'\",\"status\":\"Succeeded\",\"message\":\"Pipeline executed successfully\"}')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Send_Failure_Notification",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Set_Employee_Name",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().parameters.LogicAppUrl",
						"type": "Expression"
					},
					"body": {
						"value": "@concat('{\"pipelineName\":\"',pipeline().Pipeline,'\",\"dataFactoryName\":\"',pipeline().DataFactory,'\",\"runId\":\"',pipeline().RunId,'\",\"employeeName\":\"',variables('vEmployeeName'),'\",\"status\":\"Failed\",\"message\":\"Set Employee Name activity failed\"}')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"LogicAppUrl": {
				"type": "String"
			}
		},
		"variables": {
			"vEmployeeName": {
				"type": "String",
				"defaultValue": "1"
			}
		},
		"annotations": []
	}
}
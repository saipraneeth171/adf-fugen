{
	"name": "PL_01_Bronze_Ingest",
	"properties": {
		"activities": [
			{
				"name": "LKP_FileConfig",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT EntityName, FileName, SourceFolder, StagingTable FROM ctl.FileConfig WHERE IsActive = 1 ORDER BY FileOrder",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FE_Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LKP_FileConfig",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_FileConfig').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 2,
					"activities": [
						{
							"name": "CPY_To_Staging",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"preCopyScript": {
										"value": "@concat('DELETE FROM ', item().StagingTable)",
										"type": "Expression"
									},
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false
							}
						},
						{
							"name": "SP_LogFileSuccess",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "CPY_To_Staging",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "audit.usp_LogFile",
								"storedProcedureParameters": {
									"RunId": {
										"value": {
											"value": "@pipeline().parameters.pRunId",
											"type": "Expression"
										},
										"type": "Guid"
									},
									"EntityName": {
										"value": {
											"value": "@item().EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"FileName": {
										"value": {
											"value": "@item().FileName",
											"type": "Expression"
										},
										"type": "String"
									},
									"RowsCopied": {
										"value": {
											"value": "@activity('CPY_To_Staging').output.rowsCopied",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"Status": {
										"value": "Succeeded",
										"type": "String"
									},
									"ErrorMessage": {
										"value": "",
										"type": "String"
									}
								}
							}
						},
						{
							"name": "SP_LogFileFailure",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "CPY_To_Staging",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "audit.usp_LogFile",
								"storedProcedureParameters": {
									"RunId": {
										"value": {
											"value": "@pipeline().parameters.pRunId",
											"type": "Expression"
										},
										"type": "Guid"
									},
									"EntityName": {
										"value": {
											"value": "@item().EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"FileName": {
										"value": {
											"value": "@item().FileName",
											"type": "Expression"
										},
										"type": "String"
									},
									"RowsCopied": {
										"value": 0,
										"type": "Int64"
									},
									"Status": {
										"value": "Failed",
										"type": "String"
									},
									"ErrorMessage": {
										"value": {
											"value": "@activity('CPY_To_Staging').Error.message",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							}
						},
						{
							"name": "APPEND_FailedFile",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "SP_LogFileFailure",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "vFailedFiles",
								"value": {
									"value": "@item().FileName",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "IF_AnyFileFailed",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "FE_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(length(variables('vFailedFiles')), 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "FAIL_BronzeIngest",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('One or more files failed: ', join(variables('vFailedFiles'), ', '))",
									"type": "Expression"
								},
								"errorCode": "BRONZE_INGEST_FAILED"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"pRunId": {
				"type": "String"
			},
			"pContainer": {
				"type": "String",
				"defaultValue": "f1"
			}
		},
		"variables": {
			"vFailedFiles": {
				"type": "Array"
			}
		},
		"folder": {
			"name": "F1"
		},
		"annotations": []
	}
}
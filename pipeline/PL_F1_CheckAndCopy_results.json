{
	"name": "PL_F1_CheckAndCopy_results",
	"properties": {
		"activities": [
			{
				"name": "Get_JSONL_File_Metadata",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_F1_JSON",
						"type": "DatasetReference",
						"parameters": {
							"pContainer": "f1-data",
							"pFolderPath": {
								"value": "@pipeline().parameters.FolderPath",
								"type": "Expression"
							},
							"pFileName": {
								"value": "@pipeline().parameters.FileName",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"exists",
						"size",
						"lastModified",
						"itemName"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "If_JSONL_File_Exists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get_JSONL_File_Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Get_JSONL_File_Metadata').output.exists,true)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_File_Missing",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('JSONL file not found: ',pipeline().parameters.FolderPath,'/',pipeline().parameters.FileName)",
									"type": "Expression"
								},
								"errorCode": "F1_FILE_NOT_FOUND"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Copy_JSONL_To_Staging",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"path": "$['resultId']"
											},
											"sink": {
												"name": "resultId",
												"type": "Int32"
											}
										},
										{
											"source": {
												"path": "$['raceId']"
											},
											"sink": {
												"name": "raceId",
												"type": "Int32"
											}
										},
										{
											"source": {
												"path": "$['driverId']"
											},
											"sink": {
												"name": "driverId",
												"type": "Int32"
											}
										},
										{
											"source": {
												"path": "$['constructorId']"
											},
											"sink": {
												"name": "constructorId",
												"type": "Int32"
											}
										},
										{
											"source": {
												"path": "$['number']"
											},
											"sink": {
												"name": "number",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['grid']"
											},
											"sink": {
												"name": "grid",
												"type": "Int32"
											}
										},
										{
											"source": {
												"path": "$['position']"
											},
											"sink": {
												"name": "position",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['positionText']"
											},
											"sink": {
												"name": "positionText",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['positionOrder']"
											},
											"sink": {
												"name": "positionOrder",
												"type": "Int32"
											}
										},
										{
											"source": {
												"path": "$['points']"
											},
											"sink": {
												"name": "points",
												"type": "Decimal"
											}
										},
										{
											"source": {
												"path": "$['laps']"
											},
											"sink": {
												"name": "laps",
												"type": "Int32"
											}
										},
										{
											"source": {
												"path": "$['time']"
											},
											"sink": {
												"name": "time",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['milliseconds']"
											},
											"sink": {
												"name": "milliseconds",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['fastestLap']"
											},
											"sink": {
												"name": "fastestLap",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['rank']"
											},
											"sink": {
												"name": "rank",
												"type": "Int32"
											}
										},
										{
											"source": {
												"path": "$['fastestLapTime']"
											},
											"sink": {
												"name": "fastestLapTime",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['fastestLapSpeed']"
											},
											"sink": {
												"name": "fastestLapSpeed",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['statusId']"
											},
											"sink": {
												"name": "statusId",
												"type": "Int32"
											}
										}
									],
									"collectionReference": "",
									"mapComplexValuesToString": false
								}
							},
							"inputs": [
								{
									"referenceName": "DS_F1_Results_JSON",
									"type": "DatasetReference",
									"parameters": {
										"pContainer": "f1-data",
										"pFolderPath": "incoming/results",
										"pFileName": "results.json"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_F1_SQL",
									"type": "DatasetReference",
									"parameters": {
										"pSchema": "raw",
										"pTable": {
											"value": "@pipeline().parameters.StagingTable",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"FileName": {
				"type": "String"
			},
			"FolderPath": {
				"type": "String"
			},
			"StagingTable": {
				"type": "String"
			},
			"BatchID": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-18T02:26:17Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
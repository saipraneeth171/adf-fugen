{
	"name": "PL_F1_Load",
	"properties": {
		"activities": [
			{
				"name": "Set_BatchID",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vBatchID",
					"value": {
						"value": "@string(ticks(utcNow()))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If_Source_Is_CSV",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Set_BatchID",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(toUpper(pipeline().parameters.SourceFormat),'CSV')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Get_JSONL_File_Metadata",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:05:00",
								"retry": 1,
								"retryIntervalInSeconds": 30
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_F1_JSON",
									"type": "DatasetReference",
									"parameters": {
										"pContainer": "f1-data",
										"pFolderPath": {
											"value": "@pipeline().parameters.FolderPath",
											"type": "Expression"
										},
										"pFileName": {
											"value": "@pipeline().parameters.FileName",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"exists",
									"size",
									"lastModified",
									"itemName"
								]
							}
						},
						{
							"name": "If_JSONL_Exists",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Get_JSONL_File_Metadata",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(activity('Get_JSONL_File_Metadata').output.exists,true)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Fail_JSONL_File_Missing",
										"type": "Fail",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"message": {
												"value": "@concat('Source file not found: ',pipeline().parameters.FolderPath,'/',pipeline().parameters.FileName)",
												"type": "Expression"
											},
											"errorCode": "F1_FILE_NOT_FOUND"
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Copy_JSONL_To_Staging",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.01:00:00",
											"retry": 2,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "JsonSource",
												"additionalColumns": [
													{
														"name": "BatchID",
														"value": {
															"value": "@variables('vBatchID')",
															"type": "Expression"
														}
													}
												],
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": false
												},
												"formatSettings": {
													"type": "JsonReadSettings"
												}
											},
											"sink": {
												"type": "AzureSqlSink",
												"writeBehavior": "insert",
												"sqlWriterUseTableLock": false
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "DS_F1_JSON",
												"type": "DatasetReference",
												"parameters": {
													"pContainer": "f1-data",
													"pFolderPath": {
														"value": "@pipeline().parameters.FolderPath",
														"type": "Expression"
													},
													"pFileName": {
														"value": "@pipeline().parameters.FileName",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_F1_SQL",
												"type": "DatasetReference",
												"parameters": {
													"pSchema": "raw",
													"pTable": {
														"value": "@pipeline().parameters.StagingTable",
														"type": "Expression"
													}
												}
											}
										]
									}
								]
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Get_CSV_File_Metadata",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:05:00",
								"retry": 1,
								"retryIntervalInSeconds": 30
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_F1_CSV",
									"type": "DatasetReference",
									"parameters": {
										"pContainer": "f1-data",
										"pFolderPath": {
											"value": "@pipeline().parameters.FolderPath",
											"type": "Expression"
										},
										"pFileName": {
											"value": "@pipeline().parameters.FileName",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"exists",
									"size",
									"lastModified",
									"itemName"
								]
							}
						},
						{
							"name": "If_CSV_Exists",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Get_CSV_File_Metadata",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(activity('Get_CSV_File_Metadata').output.exists,true)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Fail_CSV_File_Missing",
										"type": "Fail",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"message": {
												"value": "@concat('Source file not found: ',pipeline().parameters.FolderPath,'/',pipeline().parameters.FileName)",
												"type": "Expression"
											},
											"errorCode": "F1_FILE_NOT_FOUND"
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Copy_CSV_To_Staging",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.01:00:00",
											"retry": 2,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "DelimitedTextSource",
												"additionalColumns": [
													{
														"name": "BatchID",
														"value": {
															"value": "@variables('vBatchID')",
															"type": "Expression"
														}
													}
												],
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": false,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "DelimitedTextReadSettings"
												}
											},
											"sink": {
												"type": "AzureSqlSink",
												"writeBehavior": "insert",
												"sqlWriterUseTableLock": false
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "DS_F1_CSV",
												"type": "DatasetReference",
												"parameters": {
													"pContainer": "f1-data",
													"pFolderPath": {
														"value": "@pipeline().parameters.FolderPath",
														"type": "Expression"
													},
													"pFileName": {
														"value": "@pipeline().parameters.FileName",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_F1_SQL",
												"type": "DatasetReference",
												"parameters": {
													"pSchema": "raw",
													"pTable": {
														"value": "@pipeline().parameters.StagingTable",
														"type": "Expression"
													}
												}
											}
										]
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"FileName": {
				"type": "String"
			},
			"FolderPath": {
				"type": "String"
			},
			"StagingTable": {
				"type": "String"
			},
			"LoadType": {
				"type": "String"
			},
			"SourceFormat": {
				"type": "String"
			}
		},
		"variables": {
			"vBatchID": {
				"type": "String"
			}
		},
		"annotations": [
			"Phase 4 first ingestion implementation",
			"File existence check and copy to parameterized SQL staging table",
			"File-level duplicate detection and control-table status updates are added in the next increment"
		]
	}
}
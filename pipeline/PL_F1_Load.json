{
	"name": "PL_F1_Load",
	"properties": {
		"activities": [
			{
				"name": "Validate_LoadType",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(equals(toUpper(pipeline().parameters.LoadType),'FULL'),equals(toUpper(pipeline().parameters.LoadType),'INCREMENTAL'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_Invalid_LoadType",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Invalid LoadType. Allowed values are FULL and INCREMENTAL.",
								"errorCode": "F1_INVALID_LOAD_TYPE"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Set_BatchID",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "vBatchID",
								"value": {
									"value": "@string(ticks(utcNow()))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "If_LoadType_Full",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Set_BatchID",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(toUpper(pipeline().parameters.LoadType),'FULL')",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "SP_Check_Existing_Batch",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [],
										"policy": {
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[ctl].[usp_CheckBatch]",
											"storedProcedureParameters": {
												"EntityName": {
													"value": {
														"value": "@pipeline().parameters.EntityName",
														"type": "Expression"
													},
													"type": "String"
												},
												"BatchID": {
													"value": {
														"value": "@variables('vBatchID')",
														"type": "Expression"
													},
													"type": "Int64"
												}
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "SP_Truncate_Raw_Table",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [],
										"policy": {
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[ctl].[usp_TruncateRawTable]",
											"storedProcedureParameters": {
												"StagingTable": {
													"value": {
														"value": "@pipeline().parameters.StagingTable",
														"type": "Expression"
													},
													"type": "String"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "AzureSqlDatabase1",
											"type": "LinkedServiceReference"
										}
									}
								]
							}
						},
						{
							"name": "If_Source_Is_CSV",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "If_LoadType_Full",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(toUpper(pipeline().parameters.SourceFormat),'CSV')",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Execute_JSONL_Child",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "PL_F1_CheckAndCopy_JSONL",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"EntityName": {
													"value": "@pipeline().parameters.EntityName",
													"type": "Expression"
												},
												"FileName": {
													"value": "@pipeline().parameters.FileName",
													"type": "Expression"
												},
												"FolderPath": {
													"value": "@pipeline().parameters.FolderPath",
													"type": "Expression"
												},
												"StagingTable": {
													"value": "@pipeline().parameters.StagingTable",
													"type": "Expression"
												},
												"BatchID": {
													"value": "@variables('vBatchID')",
													"type": "Expression"
												}
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Execute_CSV_Child",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "PL_F1_CheckAndCopy_CSV",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"EntityName": {
													"value": "@pipeline().parameters.EntityName",
													"type": "Expression"
												},
												"FileName": {
													"value": "@pipeline().parameters.FileName",
													"type": "Expression"
												},
												"FolderPath": {
													"value": "@pipeline().parameters.FolderPath",
													"type": "Expression"
												},
												"StagingTable": {
													"value": "@pipeline().parameters.StagingTable",
													"type": "Expression"
												},
												"BatchID": {
													"value": "@variables('vBatchID')",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						},
						{
							"name": "SP_Register_Successful_Batch",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "If_Source_Is_CSV",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[ctl].[usp_RegisterBatch]",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchID": {
										"value": {
											"value": "@variables('vBatchID')",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"LoadType": {
										"value": {
											"value": "@toUpper(pipeline().parameters.LoadType)",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase1",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"FileName": {
				"type": "String"
			},
			"FolderPath": {
				"type": "String"
			},
			"StagingTable": {
				"type": "String"
			},
			"SourceFormat": {
				"type": "String"
			},
			"LoadType": {
				"type": "String",
				"defaultValue": "FULL"
			}
		},
		"variables": {
			"vBatchID": {
				"type": "String"
			}
		},
		"annotations": []
	}
}
						}
					}
				}
			},
			{
				"name": "SP_Load_DimRace",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "SP_Load_DimCircuit",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "raw.usp_Load_DimRace",
					"storedProcedureParameters": {
						"RunId": {
							"value": {
								"value": "@pipeline().parameters.pRunId",
								"type": "Expression"
							},
							"type": "Guid"
						}
					}
				}
			},
			{
				"name": "SP_Load_DimDriver",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "SP_Load_DimRace",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "raw.usp_Load_DimDriver",
					"storedProcedureParameters": {
						"RunId": {
							"value": {
								"value": "@pipeline().parameters.pRunId",
								"type": "Expression"
							},
							"type": "Guid"
						}
					}
				}
			},
			{
				"name": "SP_Load_DimConstructor",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "SP_Load_DimDriver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "raw.usp_Load_DimConstructor",
					"storedProcedureParameters": {
						"RunId": {
							"value": {
								"value": "@pipeline().parameters.pRunId",
								"type": "Expression"
							},
							"type": "Guid"
						}
					}
				}
			},
			{
				"name": "LKP_DimensionValidation",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "SP_Load_DimConstructor",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT (SELECT COUNT(DISTINCT TRY_CONVERT(INT, NULLIF(LTRIM(RTRIM([driverId])), CHAR(92)+'N'))) FROM raw.Stg_Drivers) AS StgDrivers, (SELECT COUNT(*) FROM raw.DimDriver WHERE IsCurrent = 1 AND DriverKey > 0) AS CurrentDrivers, (SELECT COUNT(DISTINCT TRY_CONVERT(INT, NULLIF(LTRIM(RTRIM([constructorId])), CHAR(92)+'N'))) FROM raw.Stg_Constructors) AS StgConstructors, (SELECT COUNT(*) FROM raw.DimConstructor WHERE IsCurrent = 1 AND ConstructorKey > 0) AS CurrentConstructors",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "IF_DimensionValidation",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "LKP_DimensionValidation",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(equals(activity('LKP_DimensionValidation').output.firstRow.StgDrivers, activity('LKP_DimensionValidation').output.firstRow.CurrentDrivers), equals(activity('LKP_DimensionValidation').output.firstRow.StgConstructors, activity('LKP_DimensionValidation').output.firstRow.CurrentConstructors))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "FAIL_DimensionValidation",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Dimension validation failed. Drivers staging/current: ', string(activity('LKP_DimensionValidation').output.firstRow.StgDrivers), '/', string(activity('LKP_DimensionValidation').output.firstRow.CurrentDrivers), '; Constructors staging/current: ', string(activity('LKP_DimensionValidation').output.firstRow.StgConstructors), '/', string(activity('LKP_DimensionValidation').output.firstRow.CurrentConstructors))",
									"type": "Expression"
								},
								"errorCode": "DIMENSION_VALIDATION_FAILED"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"pRunId": {
				"type": "String"
			}
		},
		"folder": {
			"name": "F1"
		},
		"annotations": []
	}
}